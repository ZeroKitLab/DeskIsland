{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灵动岛",
  "version": "0.1.0",
  "identifier": "com.island.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "灵动岛",
        "width": 90,
        "height": 25,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/mihomo.exe": "mihomo.exe",
      "resources/mihomo-GPL-3.0.txt": "licenses/mihomo-GPL-3.0.txt",
      "resources/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "category": "Utility",
    "shortDescription": "Windows 灵动岛：时间天气、歌词与通知",
    "longDescription": "一个常驻屏幕顶部的轻量灵动岛，支持时间、星期、天气温度、AI 对话、待办、歌词与通知展示。",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
